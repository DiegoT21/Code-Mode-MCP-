{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Mode MCP",
  "version": "1.0.1",
  "identifier": "io.github.diegot21.codemodemcp",
  "build": {
    "frontendDist": "../carga"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Code Mode MCP",
        "width": 1280,
        "height": 760,
        "minWidth": 380,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "One MCP for all your MCPs",
    "longDescription": "Local panel and MCP gateway: your AI calls all its MCP tools through code and spends far fewer tokens.",
    "resources": {
      "../../bin/": "app/bin/",
      "../../lib/": "app/lib/",
      "../../public/": "app/public/",
      "../../examples/": "app/examples/",
      "../../skills/": "app/skills/",
      "../../node_modules/": "app/node_modules/",
      "../../server.mjs": "app/server.mjs",
      "../../package.json": "app/package.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"]
      }
    }
  }
}
